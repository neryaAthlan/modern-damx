[Unit]
Description=DAMX helper daemon (Acer fan, power profile and keyboard lighting)
Documentation=https://github.com/neryaAthlan/modern-damx
After=systemd-modules-load.service
# The boot preset is applied from a short delay inside damxd itself, so it
# wins over power-profiles-daemon without creating a startup ordering cycle.

[Service]
Type=simple
ExecStartPre=-/usr/sbin/modprobe linuwu_sense
ExecStart=/usr/bin/damxd
Restart=on-failure
RestartSec=3
RuntimeDirectory=damxd
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
